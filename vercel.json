{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/products/home-decor", "destination": "/products/home-decor-packaging-boxes", "statusCode": 301 },
    { "source": "/products/garden-packaging", "destination": "/products/custom-garden-plant-packaging", "statusCode": 301 },
    { "source": "/products/music-cases", "destination": "/products/musical-instrument-boxes", "statusCode": 301 },
    { "source": "/products/art-boxes", "destination": "/products/custom-art-boxes", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/blogs-data/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
