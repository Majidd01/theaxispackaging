<!-- Hero Section -->
<section class="faq-hero-section" id="faq-hero-{{ section.id }}">
  <div class="faq-hero-background" style="background-image: url('{{ section.settings.hero_image | image_url: width: 1920 }}');">
    <div class="faq-hero-overlay"></div>
  </div>
  <div class="faq-hero-content">
    <div class="faq-hero-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4M12 8h.01"></path>
      </svg>
      <span>Help Center</span>
    </div>
    <h1 class="faq-hero-title">
      {% if section.settings.hero_title != blank %}
        {{ section.settings.hero_title }}
      {% else %}
        Frequently Asked Questions
      {% endif %}
    </h1>
    {% if section.settings.hero_description != blank %}
      <p class="faq-hero-description">{{ section.settings.hero_description }}</p>
    {% endif %}
  </div>
</section>

<section class="tc-tabs-faq" id="tc-tabs-faq-{{ section.id }}">
  <div class="tc-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="tc-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign tab_blocks = section.blocks | where: "type", "tab" %}
    {% assign faq_blocks = section.blocks | where: "type", "faq" %}

    {% if tab_blocks.size > 0 %}
      <div class="tc-tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Tabs' }}">
        {% for b in tab_blocks %}
          {% assign tab_key_raw = b.settings.key | strip %}
          {% if tab_key_raw == blank %}
            {% assign tab_key_raw = b.settings.label | strip %}
          {% endif %}
          {% assign tab_key_norm = tab_key_raw | handleize %}

          {% assign is_active = false %}
          {% if section.settings.default_active_key != blank %}
            {% assign default_norm = section.settings.default_active_key | strip | handleize %}
            {% if default_norm == tab_key_norm %}
              {% assign is_active = true %}
            {% endif %}
          {% else %}
            {% if forloop.first %}
              {% assign is_active = true %}
            {% endif %}
          {% endif %}

          <button
            class="tc-tab-btn {% if is_active %}is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if is_active %}true{% else %}false{% endif %}"
            aria-controls="tc-panel-{{ section.id }}-{{ tab_key_norm }}"
            id="tc-tab-{{ section.id }}-{{ tab_key_norm }}"
            data-tab-key="{{ tab_key_norm }}"
          >
            {{ b.settings.label }}
          </button>
        {% endfor %}
      </div>

      <div class="tc-panels">
        {% for b in tab_blocks %}
          {% assign tab_key_raw = b.settings.key | strip %}
          {% if tab_key_raw == blank %}
            {% assign tab_key_raw = b.settings.label | strip %}
          {% endif %}
          {% assign tab_key_norm = tab_key_raw | handleize %}

          {% assign is_active = false %}
          {% if section.settings.default_active_key != blank %}
            {% assign default_norm = section.settings.default_active_key | strip | handleize %}
            {% if default_norm == tab_key_norm %}
              {% assign is_active = true %}
            {% endif %}
          {% else %}
            {% if forloop.first %}
              {% assign is_active = true %}
            {% endif %}
          {% endif %}

          <div
            class="tc-panel {% if is_active %}is-active{% endif %}"
            role="tabpanel"
            tabindex="0"
            id="tc-panel-{{ section.id }}-{{ tab_key_norm }}"
            aria-labelledby="tc-tab-{{ section.id }}-{{ tab_key_norm }}"
            data-panel-key="{{ tab_key_norm }}"
          >
            {% assign has_faq = false %}

            <div class="tc-accordion" data-accordion-group data-one-open="{{ section.settings.only_one_open }}">
              {% for f in faq_blocks %}
                {% assign faq_key_norm = f.settings.tab_key | strip | handleize %}
                {% if faq_key_norm == tab_key_norm %}
                  {% assign has_faq = true %}

                  {% assign open_attr = "" %}
                  {% if f.settings.open_by_default %}
                    {% assign open_attr = "open" %}
                  {% endif %}

                  <details class="tc-item" {{ open_attr }}>
                    <summary class="tc-q">
                      <span class="tc-q-text">{{ f.settings.question }}</span>

                      <span class="tc-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">
                          <path d="M6.7 9.3a1 1 0 0 1 1.4 0L12 13.2l3.9-3.9a1 1 0 1 1 1.4 1.4l-4.6 4.6a1 1 0 0 1-1.4 0L6.7 10.7a1 1 0 0 1 0-1.4z"></path>
                        </svg>
                      </span>
                    </summary>

                    <div class="tc-content" aria-hidden="true">
                      <div class="tc-a rte">
                        {{ f.settings.answer }}
                      </div>
                    </div>
                  </details>
                {% endif %}
              {% endfor %}
            </div>

            {% unless has_faq %}
              <p class="tc-empty">
                No FAQs found for "{{ b.settings.label }}".
                Add FAQ blocks and set <strong>Tab Key</strong> = <strong>{{ tab_key_raw }}</strong>
                (matches by handleize: "{{ tab_key_norm }}").
              </p>
            {% endunless %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="tc-empty">Add at least 1 Tab block.</p>
    {% endif %}
  </div>

  <style>
    /* Hero Section Styles */
    #faq-hero-{{ section.id }} {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      overflow: hidden;
    }
    #faq-hero-{{ section.id }} .faq-hero-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    #faq-hero-{{ section.id }} .faq-hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.4), rgba(0,0,0,0.6));
    }
    #faq-hero-{{ section.id }} .faq-hero-content {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
      color: white;
    }
    #faq-hero-{{ section.id }} .faq-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      color: #333;
      margin-bottom: 24px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    #faq-hero-{{ section.id }} .faq-hero-badge svg {
      color: #f97316;
    }
    #faq-hero-{{ section.id }} .faq-hero-title {
      font-size: clamp(32px, 5vw, 64px);
      font-weight: 800;
      margin: 0 0 16px 0;
      text-shadow: 3px 3px 6px rgba(0,0,0,0.9);
      line-height: 1.2;
    }
    #faq-hero-{{ section.id }} .faq-hero-title span {
      background: linear-gradient(to right, #fb923c, #fef3c7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    #faq-hero-{{ section.id }} .faq-hero-description {
      font-size: clamp(16px, 2vw, 20px);
      max-width: 700px;
      margin: 0 auto;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
      line-height: 1.6;
      opacity: 0.95;
    }

    @media (max-width: 768px) {
      #faq-hero-{{ section.id }} {
        min-height: 50vh;
      }
      #faq-hero-{{ section.id }} .faq-hero-content {
        padding: 40px 16px;
      }
    }

    #tc-tabs-faq-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      min-height:60vh;
    }
    #tc-tabs-faq-{{ section.id }} .tc-wrap{
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 16px;
    }
    #tc-tabs-faq-{{ section.id }} .tc-heading{
      text-align: center;
      margin: 50px 0;
      font-size: clamp(22px, 2.2vw, 34px);
      font-weight: 700;
    }

    /* Tabs */
    #tc-tabs-faq-{{ section.id }} .tc-tabs{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap: 12px;
      margin-bottom: 30px;
    }
    #tc-tabs-faq-{{ section.id }} .tc-tab-btn{
      border: 1px solid rgba(0,0,0,.18);
      background: #fff;
      color: #111;
      padding: 10px 18px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      line-height: 1;
      transition: transform .12s ease, background .12s ease, border-color .12s ease;
      white-space: nowrap;
      flex: 0 0 auto;
    }
    #tc-tabs-faq-{{ section.id }} .tc-tab-btn:hover{ transform: translateY(-1px); }
    #tc-tabs-faq-{{ section.id }} .tc-tab-btn.is-active{
      background: {{ section.settings.active_tab_bg }};
      color: {{ section.settings.active_tab_color }};
      border-color: transparent;
    }

    /* Mobile tabs scroll (<= 768px) */
    @media (max-width: 768px){
      #tc-tabs-faq-{{ section.id }} .tc-tabs{
        justify-content:flex-start;
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        padding: 4px 2px 10px;
        margin-left: -2px;
        margin-right: -2px;
        scroll-snap-type: x mandatory;
      }
      #tc-tabs-faq-{{ section.id }} .tc-tab-btn{
        scroll-snap-align: start;
      }

      /* Optional: hide scrollbar */
      #tc-tabs-faq-{{ section.id }} .tc-tabs::-webkit-scrollbar{
        height: 0px;
      }
      #tc-tabs-faq-{{ section.id }} .tc-tabs{
        scrollbar-width: none;
      }
    }

    /* Panels */
    #tc-tabs-faq-{{ section.id }} .tc-panel{ display:none; }
    #tc-tabs-faq-{{ section.id }} .tc-panel.is-active{ display:block; }

    /* Accordion */
    #tc-tabs-faq-{{ section.id }} .tc-accordion{
      max-width: 980px;
      margin: 0 auto;
    }
    #tc-tabs-faq-{{ section.id }} .tc-item{
      border: 1px solid rgba(0,0,0,.12);
      border-radius: 12px;
      overflow: hidden;
      background:#fff;
      margin-bottom: 12px;
    }
    #tc-tabs-faq-{{ section.id }} .tc-q{
      list-style:none;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 12px;
      padding: 16px 16px;
      cursor:pointer;
      font-weight: 700;
    }
    #tc-tabs-faq-{{ section.id }} details > summary::-webkit-details-marker{ display:none; }

    #tc-tabs-faq-{{ section.id }} .tc-icon{
      display:inline-flex;
      transition: transform .18s ease;
    }
    #tc-tabs-faq-{{ section.id }} details[open] .tc-icon{
      transform: rotate(180deg);
    }
    #tc-tabs-faq-{{ section.id }} .tc-icon svg{
    width: 2rem;
    height: 2rem;
    }
    /* Smooth content animation (open + close) */
    #tc-tabs-faq-{{ section.id }} .tc-content{
      max-height: 0;
      overflow: hidden;
      transition: max-height .32s ease;
    }
    #tc-tabs-faq-{{ section.id }} .tc-a{
      padding: 0 16px 16px;
      color: rgba(0,0,0,.78);
      line-height: 1.6;
    }

    #tc-tabs-faq-{{ section.id }} .tc-empty{
      text-align:center;
      opacity:.75;
      padding: 12px 0;
    }
  </style>

  <script>
    (function(){
      const root = document.getElementById('tc-tabs-faq-{{ section.id }}');
      if(!root) return;

      // Tabs
      const tabButtons = root.querySelectorAll('.tc-tab-btn');
      const panels = root.querySelectorAll('.tc-panel');

      function activateTab(tabKey){
        tabButtons.forEach(btn=>{
          const active = btn.dataset.tabKey === tabKey;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panels.forEach(p=>{
          p.classList.toggle('is-active', p.dataset.panelKey === tabKey);
        });

        // Re-init accordions for the active panel (height recalculation)
        panels.forEach(p=>{
          if(p.classList.contains('is-active')){
            initAccordionIn(p);
          }
        });
      }

      tabButtons.forEach(btn=>{
        btn.addEventListener('click', ()=> activateTab(btn.dataset.tabKey));
      });

      // Smooth accordion animation helpers
      function openDetails(detailsEl){
        const content = detailsEl.querySelector('.tc-content');
        if(!content) return;

        detailsEl.setAttribute('open', '');
        // next frame -> set actual height
        requestAnimationFrame(()=>{
          content.style.maxHeight = content.scrollHeight + 'px';
          content.setAttribute('aria-hidden', 'false');
        });
      }

      function closeDetails(detailsEl){
        const content = detailsEl.querySelector('.tc-content');
        if(!content) return;

        // IMPORTANT: set current height first, then animate to 0
        content.style.maxHeight = content.scrollHeight + 'px';
        content.setAttribute('aria-hidden', 'true');

        requestAnimationFrame(()=>{
          content.style.maxHeight = '0px';
        });

        // after transition ends, remove open attribute
        const onEnd = (e)=>{
          if(e.propertyName !== 'max-height') return;
          detailsEl.removeAttribute('open');
          content.removeEventListener('transitionend', onEnd);
        };
        content.addEventListener('transitionend', onEnd);
      }

      function initAccordionIn(scope){
        const groups = scope.querySelectorAll('[data-accordion-group]');
        groups.forEach(group=>{
          // prevent double-binding if called multiple times
          if(group.dataset.inited === 'true') {
            // still recalc heights for open items
            group.querySelectorAll('details.tc-item[open]').forEach(d=>{
              const c = d.querySelector('.tc-content');
              if(c) c.style.maxHeight = c.scrollHeight + 'px';
            });
            return;
          }
          group.dataset.inited = 'true';

          const oneOpen = group.dataset.oneOpen === 'true';
          const items = Array.from(group.querySelectorAll('details.tc-item'));

          // init heights
          items.forEach(d=>{
            const content = d.querySelector('.tc-content');
            if(!content) return;
            if(d.hasAttribute('open')){
              content.style.maxHeight = content.scrollHeight + 'px';
              content.setAttribute('aria-hidden', 'false');
            } else {
              content.style.maxHeight = '0px';
              content.setAttribute('aria-hidden', 'true');
            }
          });

          // click handling
          items.forEach(d=>{
            const summary = d.querySelector('summary');
            if(!summary) return;

            summary.addEventListener('click', (e)=>{
              e.preventDefault();

              const isOpen = d.hasAttribute('open');

              if(oneOpen && !isOpen){
                items.forEach(other=>{
                  if(other !== d && other.hasAttribute('open')){
                    closeDetails(other);
                  }
                });
              }

              if(isOpen){
                closeDetails(d);
              } else {
                openDetails(d);
              }
            });
          });

          // resize update
          const onResize = ()=>{
            items.forEach(d=>{
              if(d.hasAttribute('open')){
                const content = d.querySelector('.tc-content');
                if(content) content.style.maxHeight = content.scrollHeight + 'px';
              }
            });
          };
          window.addEventListener('resize', onResize, { passive: true });
        });
      }

      // init only active panel accordions
      panels.forEach(p=>{
        if(p.classList.contains('is-active')){
          initAccordionIn(p);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Tabs + FAQs Accordion",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image",
      "info": "Recommended size: 1920x800px"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Find comprehensive answers to all your questions about custom packaging solutions, ordering process, and our services."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ's"
    },
    {
      "type": "text",
      "id": "default_active_key",
      "label": "Default Active Tab Key (optional)",
      "info": "Example: Account&Setup or account-setup. If empty, first tab will be active."
    },
    {
      "type": "checkbox",
      "id": "only_one_open",
      "label": "Only one FAQ open at a time",
      "default": true
    },
    {
      "type": "color",
      "id": "active_tab_bg",
      "label": "Active tab background",
      "default": "#e91e63"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active tab text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "Account & Setup"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Tab Key",
          "info": "Unique key. Example: Account&Setup OR account-setup. FAQs match by handleize.",
          "default": "Account&Setup"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ (Accordion item)",
      "settings": [
        {
          "type": "text",
          "id": "tab_key",
          "label": "Tab Key (match a Tab Key)",
          "info": "Must match the Tab Key (any format). Example: Account&Setup",
          "default": "Account&Setup"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can my partner access the same account?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. You can invite your partner to collaborate on the same plan.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs + FAQs Accordion",
      "blocks": [
        { "type": "tab", "settings": { "label": "Account & Setup", "key": "Account&Setup" } },
        { "type": "tab", "settings": { "label": "Payments", "key": "Payments" } },
        { "type": "faq", "settings": { "tab_key": "Account&Setup", "question": "Can my partner access the same account?" } },
        { "type": "faq", "settings": { "tab_key": "Account&Setup", "question": "How do I change my password?" } },
        { "type": "faq", "settings": { "tab_key": "Payments", "question": "Which payment methods are accepted?" } }
      ]
    }
  ]
}
{% endschema %}